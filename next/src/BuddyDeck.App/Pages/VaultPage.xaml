<UserControl
    x:Class="BuddyDeck.App.Pages.VaultPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:bd="clr-namespace:BuddyDeck.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!--
        账号池页（嵌套层级导航）。

        不是左右分栏，而是**同一内容区纵向嵌套**：
          · 层级 1：池卡片网格（WrapPanel，悬浮动画，卡片带 启动/编辑/更多）
          · 层级 2：选中池的账号表单（筛选 + 分页，点账号进入详情）
          · 层级 3：账号详情（AccountDetailView + 操作按钮）

        每层有「返回」按钮上浮，有淡入动画。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======== 页头 + 动作 ======== -->
        <Grid Grid.Row="0" Margin="28,22,28,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- 返回按钮（非池层显示） -->
                    <ui:Button
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Command="{Binding GoBackCommand}"
                        Content="返回"
                        Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                        Visibility="{Binding IsPoolsLevel, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock
                        Style="{DynamicResource TextPageTitle}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="账号池" />
                </StackPanel>
                <TextBlock
                    Margin="0,5,0,0"
                    Style="{DynamicResource TextSmall}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="池 → 账号 → 详情，嵌套导航" />

                <!-- 池子总积分 -->
                <Border
                    Margin="0,12,0,0"
                    Padding="16,10"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource RailSubtleBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="{StaticResource BorderHairline}"
                    CornerRadius="{StaticResource RadiusPanel}"
                    Visibility="{Binding Pools.HasPoolCredit, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{DynamicResource TextNumberStrong}"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="{Binding Pools.PoolCreditTotal}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                Style="{DynamicResource TextMicro}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="池子总积分" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{DynamicResource TextMicro}"
                                Foreground="{DynamicResource TextTertiaryBrush}"
                                Text="所有池的积分总和" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Command="{Binding Pools.NewPoolCommand}"
                    Content="新建池"
                    Icon="{ui:SymbolIcon Symbol=Add24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding Accounts.CheckinAllCommand}"
                    Content="一键签到"
                    Icon="{ui:SymbolIcon Symbol=Checkmark24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Command="{Binding Accounts.RefreshCreditsCommand}"
                    Content="刷新积分"
                    Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                    ToolTip="后台重新拉取全部账号的最新积分（进度在右侧任务库）" />
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Click="OnImportClick"
                    Content="导入账号"
                    Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                <ui:Button
                    Appearance="Secondary"
                    Click="OnRefreshClick"
                    Content="刷新"
                    Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
            </StackPanel>
        </Grid>

        <!-- ======== 嵌套内容区 ======== -->
        <ScrollViewer Grid.Row="1" Margin="28,16,28,24" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 提示条（启停/编辑/删除的结果反馈） -->
                <Border
                    Margin="0,0,0,12"
                    Padding="10,8"
                    Background="{DynamicResource RailSubtleBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="{StaticResource BorderHairline}"
                    CornerRadius="{StaticResource RadiusRow}"
                    Visibility="{Binding Pools.Notice, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding Pools.Notice}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" /><Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pools.NoticeIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StopBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- ══ 层级 1：号池（new_api 风格：统计卡 + 表格）══ -->
                <StackPanel Visibility="{Binding IsPoolsLevel, Converter={StaticResource BoolToVisibility}}">
                    <!-- 统计概览行 -->
                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                        <Border
                            MinWidth="120"
                            Margin="0,0,10,0"
                            Padding="14,10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="{StaticResource BorderHairline}"
                            CornerRadius="{StaticResource RadiusRow}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource TextMicro}" Foreground="{DynamicResource TextTertiaryBrush}" Text="接入池总数" />
                                <TextBlock Margin="0,3,0,0" Style="{DynamicResource TextNumberStrong}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Pools.Pools.Count}" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="120"
                            Margin="0,0,10,0"
                            Padding="14,10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="{StaticResource BorderHairline}"
                            CornerRadius="{StaticResource RadiusRow}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource TextMicro}" Foreground="{DynamicResource TextTertiaryBrush}" Text="运行中" />
                                <TextBlock Margin="0,3,0,0" Style="{DynamicResource TextNumberStrong}" Foreground="{DynamicResource OkBrush}" Text="{Binding Pools.RunningCount}" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="120"
                            Margin="0,0,10,0"
                            Padding="14,10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="{StaticResource BorderHairline}"
                            CornerRadius="{StaticResource RadiusRow}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource TextMicro}" Foreground="{DynamicResource TextTertiaryBrush}" Text="已停止" />
                                <TextBlock Margin="0,3,0,0" Style="{DynamicResource TextNumberStrong}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Pools.StoppedCount}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 表格（new_api 风格行列表） -->
                    <Border
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="{StaticResource BorderHairline}"
                        CornerRadius="{StaticResource RadiusPanel}">
                        <ItemsControl ItemsSource="{Binding Pools.Pools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 状态色条 -->
                                        <Border Grid.Column="0" CornerRadius="{StaticResource RadiusBar}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource IdleRailBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Running}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource OkRailBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- 名称（点它进入账号层） -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OnPoolRowOpen">
                                            <StackPanel.Tag>
                                                <Binding />
                                            </StackPanel.Tag>
                                            <TextBlock Style="{DynamicResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Margin="0,4,0,0"
                                                Padding="5,1,5,1"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource RailBrush}"
                                                CornerRadius="{StaticResource RadiusBar}"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource TextSecondaryBrush}" Text="默认" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 地址 -->
                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource TextSmall}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />

                                        <!-- 账号数 -->
                                        <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource TextSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AccountCountText}" />

                                        <!-- 状态徽章 -->
                                        <StackPanel Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Border
                                                Padding="6,2,6,2"
                                                HorizontalAlignment="Left"
                                                CornerRadius="{StaticResource RadiusBar}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource RailSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Running}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkBadgeBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="{StaticResource FontSizeBadge}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Setter Property="Text" Value="已停止" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Running}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                                    <Setter Property="Text" Value="运行中" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- 操作按钮 -->
                                        <StackPanel Grid.Column="5" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button
                                                Margin="0,0,6,0"
                                                Padding="8,3"
                                                Appearance="Secondary"
                                                Click="OnPoolToggleRow"
                                                Content="{Binding ToggleText}"
                                                FontSize="11"
                                                Tag="{Binding}" />
                                            <ui:Button
                                                Margin="0,0,6,0"
                                                Padding="8,3"
                                                Appearance="Transparent"
                                                Click="OnPoolEditRow"
                                                Content="编辑"
                                                FontSize="11"
                                                Tag="{Binding}" />
                                            <ui:Button
                                                Padding="8,3"
                                                Appearance="Transparent"
                                                Click="OnPoolRemoveRow"
                                                Content="删除"
                                                FontSize="11"
                                                Tag="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <bd:EmptyState
                        Margin="0,40,0,0"
                        Headline="还没有池"
                        Detail="点右上角「新建池」建一个。"
                        Visibility="{Binding Pools.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- ══ 层级 2：账号表单（筛选 + 分页）══ -->
                <StackPanel Visibility="{Binding IsAccountsLevel, Converter={StaticResource BoolToVisibility}}">
                    <!-- 池名标题 -->
                    <Border
                        Padding="16,12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="{StaticResource BorderHairline}"
                        CornerRadius="{StaticResource RadiusPanel}">
                        <StackPanel>
                            <TextBlock
                                Style="{DynamicResource TextSectionTitle}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding SelectedPool.DisplayName, StringFormat={}{0} 的账号}" />
                            <ui:TextBox
                                Margin="0,10,0,0"
                                PlaceholderText="筛选标签 / uid"
                                Text="{Binding Pools.AccountFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!-- 账号列表 -->
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Pools.PoolAccountsView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="{StaticResource BorderHairline}"
                                    CornerRadius="{StaticResource RadiusRow}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnAccountClick">
                                    <Grid Tag="{Binding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{Binding State, Converter={StaticResource AccountStateBrush}, ConverterParameter=rail}"
                                            CornerRadius="{StaticResource RadiusBar}" />

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Style="{DynamicResource TextBody}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <bd:AccountStateBadge
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    State="{Binding State}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{DynamicResource TextSmall}"
                                                Foreground="{DynamicResource TextTertiaryBrush}"
                                                Text="{Binding Remaining}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource TextNumber}"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="{Binding CreditTotal}"
                                            Visibility="{Binding HasCredits, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 分页 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Appearance="Transparent"
                            Command="{Binding Pools.PrevPageCommand}"
                            Content="上一页"
                            Visibility="{Binding Pools.HasPrevPage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{DynamicResource TextMicro}"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            Text="{Binding Pools.AccountPageText}" />
                        <ui:Button
                            Grid.Column="2"
                            Appearance="Transparent"
                            Command="{Binding Pools.NextPageCommand}"
                            Content="下一页"
                            Visibility="{Binding Pools.HasNextPage, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>

                <!-- ══ 层级 3：账号详情 ══ -->
                <StackPanel Visibility="{Binding IsDetailLevel, Converter={StaticResource BoolToVisibility}}">
                    <Border
                        Padding="{StaticResource SpaceControl}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="{StaticResource BorderHairline}"
                        CornerRadius="{StaticResource RadiusPanel}">
                        <StackPanel>
                            <!-- 详情表单 -->
                            <bd:AccountDetailView DataContext="{Binding SelectedAccount}" />

                            <Rectangle
                                Height="1"
                                Margin="0,16,0,14"
                                Fill="{DynamicResource HairlineBrush}" />

                            <!-- 操作按钮 -->
                            <ui:Button
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Appearance="Secondary"
                                Command="{Binding Accounts.ActivateCommand}"
                                Content="切换到这个号" />
                            <ui:Button
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Appearance="Secondary"
                                Command="{Binding Accounts.RefreshTokenCommand}"
                                Content="续期 token" />
                            <ui:Button
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Appearance="Transparent"
                                Command="{Binding Accounts.RenameCommand}"
                                Content="改名" />
                            <ui:Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Appearance="Danger"
                                Command="{Binding Accounts.RemoveCommand}"
                                Content="删除这个号" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ★ 池编辑器弹窗（新建/编辑共用） -->
        <Border
            Background="#80000000"
            Visibility="{Binding Pools.ShowEditor, Converter={StaticResource BoolToVisibility}}">
            <Border
                Width="360"
                Padding="20,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="{StaticResource BorderHairline}"
                CornerRadius="{StaticResource RadiusPanel}">
                <StackPanel>
                    <TextBlock
                        Style="{DynamicResource TextSectionTitle}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Pools.EditorTitle}" />

                    <TextBlock
                        Margin="0,14,0,6"
                        Style="{DynamicResource FieldLabel}"
                        Text="名字" />
                    <ui:TextBox
                        PlaceholderText="比如：默认池"
                        Text="{Binding Pools.EditorName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Style="{DynamicResource FieldLabel}"
                        Text="端口" />
                    <ui:TextBox
                        PlaceholderText="8788"
                        Text="{Binding Pools.EditorPort, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Style="{DynamicResource FieldLabel}"
                        Text="API key" />
                    <ui:TextBox
                        PlaceholderText="给客户端用的密钥（空 = 不鉴权）"
                        Text="{Binding Pools.EditorApiKey, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Transparent"
                            Command="{Binding Pools.CancelEditorCommand}"
                            Content="取消" />
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding Pools.SaveEditorCommand}"
                            Content="保存" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
