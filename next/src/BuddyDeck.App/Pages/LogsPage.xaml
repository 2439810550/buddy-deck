<UserControl
    x:Class="BuddyDeck.App.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:bd="clr-namespace:BuddyDeck.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!--
        日志页。
        网关的日志**只有元数据**（谁、哪个模型、什么结果、多久），
        提示词和响应正文不进日志 —— 页面文案也照着这个前提写，
        不承诺能看到正文。
    -->
    <Grid Margin="{StaticResource SpacePage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock
                    Style="{DynamicResource TextPageTitle}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="日志" />
                <TextBlock
                    Margin="0,5,0,0"
                    Style="{DynamicResource TextSmall}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="网关记了什么（只有元数据，不写提示词和凭证）" />
            </StackPanel>
            <ui:Button
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Appearance="Secondary"
                Command="{Binding RefreshCommand}"
                Content="读取日志"
                Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
        </Grid>

        <!-- 过滤器 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,14"
            Padding="12,10,12,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="{StaticResource BorderHairline}"
            CornerRadius="{StaticResource RadiusPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource FieldLabel}"
                    Text="级别" />
                <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Levels}"
                    SelectedItem="{Binding Level}" />

                <TextBlock
                    Grid.Column="2"
                    Margin="14,0,8,0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource FieldLabel}"
                    Text="时间" />
                <ComboBox
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Windows}"
                    SelectedItem="{Binding Window}" />

                <TextBlock
                    Grid.Column="4"
                    Margin="14,0,8,0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource FieldLabel}"
                    Text="找" />
                <ui:TextBox
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    PlaceholderText="在消息里找关键字"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Column="6"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource TextNumber}"
                    Foreground="{DynamicResource TextTertiaryBrush}"
                    Text="{Binding Lines.Count, StringFormat={}{0} 行}" />
            </Grid>
        </Border>

        <!-- 日志行 -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="{StaticResource BorderHairline}"
            CornerRadius="{StaticResource RadiusPanel}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12,7,12,7"
                                    BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{DynamicResource TextNumber}"
                                            Foreground="{DynamicResource TextTertiaryBrush}"
                                            Text="{Binding At, StringFormat={}{0:HH:mm:ss}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{DynamicResource TextSmall}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text="{Binding Level}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{DynamicResource TextBody}"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <bd:EmptyState
                    Headline="这一页没有日志行"
                    Detail="{Binding EmptyNotice}"
                    Visibility="{Binding Lines, Converter={StaticResource EmptyCollectionToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
