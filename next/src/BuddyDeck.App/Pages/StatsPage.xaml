<UserControl
    x:Class="BuddyDeck.App.Pages.StatsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:bd="clr-namespace:BuddyDeck.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!--
        用量统计页（t72）。

        结构：
          ① 范围切换（今天 / 近 7 天 / 近 30 天 / 本月）+ 范围说明
          ② 三个维度的数字（请求 / Token / 积分）—— 一行三个
          ③ 空态（没有数据时**替换掉** ② 而不是留三个 0）

        ⚠ 不用卡片容器包一切（design 计划 1.8 原则 2）：
        信息照抄参考项目、形态不照抄。
    -->
    <Grid Margin="{StaticResource SpacePage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======== 顶部：标题 + 范围切换 ======== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                Style="{DynamicResource TextPageTitle}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="用量统计" />

            <!--
                范围说明：用户看到「今天 0 个请求」第一反应是「坏了」，
                所以说清这个「今天」从几点算起。
            -->
            <TextBlock
                Margin="0,4,0,0"
                Style="{DynamicResource TextSmall}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding RangeCaption}"
                TextWrapping="Wrap" />

            <!--
                范围切换。用 ItemsControl 而不是四个写死的按钮：
                范围清单来自 StatsPresentation.AllRanges（唯一真源），
                加一个范围只需改那一处。
            -->
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Ranges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="{Binding Appearance}"
                            Command="{Binding SelectCommand}"
                            Content="{Binding Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ======== 主体 ======== -->
        <Grid Grid.Row="1">
            <!-- 有数据：三个维度 -->
            <Grid
                VerticalAlignment="Top"
                Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock
                        Style="{DynamicResource TextSmall}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="请求数" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource TextNumberStrong}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding RequestsText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource TextSmall}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding RequestsDetail}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{DynamicResource TextSmall}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding SuccessRateText, StringFormat=成功率 {0}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock
                        Style="{DynamicResource TextSmall}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Token 消耗" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource TextNumberStrong}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding TokensText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource TextSmall}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding TokensDetail}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock
                        Style="{DynamicResource TextSmall}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="积分消耗" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{DynamicResource TextNumberStrong}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding CreditText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource TextSmall}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding CreditDetail}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--
                空态：**替换掉**数字区。
                文案由 StatsPresentation.EmptyHint 给（说清为什么空 + 怎么办），
                不是「暂无数据」那种没用的空态。
            -->
            <bd:EmptyState
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Detail="{Binding EmptyHint}"
                Headline="这段时间没有用量"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
