<Window x:Class="WorkBuddyPanel.PoolEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkBuddy 控制台"
        Width="470" SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- 输入框：标签在上、控件在下，垂直排列，避免长中文被压扁 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSub}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock x:Name="TitleText" Text="新建池"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMain}" />
        <TextBlock Text="池 = 一套账号 + 一个独立的接入地址。给不同的人用，各跑各的。"
                   FontSize="12.5" Foreground="{StaticResource TextSub}"
                   TextWrapping="Wrap" Margin="0,6,0,16" />

        <!-- 池名 -->
        <TextBlock Text="池的名字（自己认得出就行）" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Padding="8,6" Margin="0,0,0,14"
                 BorderBrush="{StaticResource Line}" BorderThickness="1" />

        <!-- 备注 -->
        <TextBlock Text="备注（给谁用的，可留空）" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NoteBox" Padding="8,6" Margin="0,0,0,14"
                 BorderBrush="{StaticResource Line}" BorderThickness="1" />

        <!-- 端口 -->
        <TextBlock Text="端口（客户端地址里的那个数字）" Style="{StaticResource FieldLabel}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PortBox" Grid.Column="0" Padding="8,6"
                     BorderBrush="{StaticResource Line}" BorderThickness="1" />
            <Button Grid.Column="1" Content="换一个空闲的" Margin="8,0,0,0"
                    Padding="10,6" Click="OnPickFreePort"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Background="White" />
        </Grid>
        <TextBlock x:Name="PortHint" FontSize="12" Foreground="{StaticResource TextSub}"
                   TextWrapping="Wrap" Margin="0,0,0,18" />

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" MinWidth="88" Padding="12,7"
                    Click="OnCancel" IsCancel="True"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Background="White" />
            <Button Content="确定" MinWidth="96" Padding="12,7" Margin="10,0,0,0"
                    Click="OnOk" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
