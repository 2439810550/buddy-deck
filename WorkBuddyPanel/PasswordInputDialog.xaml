<Window x:Class="WorkBuddyPanel.PasswordInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="口令" Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource TextMain}" Margin="0,0,0,12" />

        <PasswordBox x:Name="FirstBox" Grid.Row="1" FontSize="14" Padding="8,6" />

        <TextBlock Grid.Row="2" Text="再输一遍确认" Style="{StaticResource Field}" Margin="0,10,0,3"
                   x:Name="ConfirmLabel" />
        <PasswordBox x:Name="SecondBox" Grid.Row="3" FontSize="14" Padding="8,6" />

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextSub}" Margin="0,12,0,0" />
            <TextBlock x:Name="WarnText" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource Warn}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="Ok_Click" IsDefault="True" />
            <Button Content="取消" Style="{StaticResource GhostButton}" MinWidth="80" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
