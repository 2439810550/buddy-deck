<Window x:Class="WorkBuddyPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WorkBuddyPanel.ViewModels"
        Title="WorkBuddy 控制台" Height="820" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Margin="12,12,12,0" Background="{StaticResource Bg}" BorderThickness="0">

            <!-- ══════════════ 首页 ══════════════ -->
            <TabItem Header="  首页  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <StackPanel Margin="4,10,4,10">

                        <!-- 网关开关 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="本地网关" Style="{StaticResource H1}" />

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                             Fill="{Binding GatewayStateBrush}" />
                                    <TextBlock Text="{Binding GatewayStateText}" FontSize="17" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding GatewayStateBrush}" />
                                    <TextBlock Text="  —  启动后，任何支持 OpenAI 接口的软件都能用 WorkBuddy 的模型"
                                               Style="{StaticResource Sub}" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="启动网关" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding StartGatewayCommand}" MinWidth="110" />                                    <Button Content="停止" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding StopGatewayCommand}" MinWidth="80" />
                                    <Button Content="刷新账号信息" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RefreshStatusCommand}" />
                                    <Button Content="一键体检" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RunDoctorCommand}" />
                                    <Button Content="自动探测路径" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding AutoDetectAllCommand}" />
                                </StackPanel>

                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Sub}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 连接信息 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="连接信息（复制给别的软件用）" Style="{StaticResource H1}" />

                                <TextBlock Text="Base URL" Style="{StaticResource Field}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ReadOnlyValue}"
                                             Text="{Binding BaseUrl, Mode=OneWay}" />
                                    <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Command="{Binding CopyBaseUrlCommand}" />
                                </Grid>

                                <TextBlock Text="API Key" Style="{StaticResource Field}" Margin="0,12,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ReadOnlyValue}"
                                             Text="{Binding ApiKey, Mode=OneWay}" />
                                    <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Command="{Binding CopyApiKeyCommand}" />
                                </Grid>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0">
                                    <Run Text="没启动网关时 Base URL 是空的。先点最上面的「启动网关」。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 当前账号（旧的「账号与额度」卡片：详情已经归到「账号」页，
                             这里只留一行摘要，不重复摆一遍） -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="当前使用的账号" Style="{StaticResource H1}" />

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="正在用"
                                                   Style="{StaticResource Sub}" Margin="0,0,0,6" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding ActiveAccountShort}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding AccountsCountText}" Style="{StaticResource Sub}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="剩余积分"
                                                   Style="{StaticResource Sub}" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusCreditsText}" FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Sub}" Margin="14,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="可用模型 " />
                                                <Run Text="{Binding ModelCountText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0">
                                    <Run Text="切号、签到、续期、看详情都在「账号」页。这里只显示摘要。" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="去账号页" Style="{StaticResource PrimaryButton}"
                                            Click="GoToAccountsTab_Click" MinWidth="100" />
                                    <Button Content="刷新模型列表" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RefreshModelsCommand}" />
                                    <Button Content="打开状态目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding OpenStateFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 使用说明 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="怎么用（三步）" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10">
                                    <Run Text="1." FontWeight="SemiBold" />
                                    <Run Text="点上面的「启动网关」，等状态变成绿色「运行中」。" />
                                    <LineBreak />
                                    <Run Text="2." FontWeight="SemiBold" />
                                    <Run Text="去「对话」标签页直接试一句，确认账号有额度、模型能用。" />
                                    <LineBreak />
                                    <Run Text="3." FontWeight="SemiBold" />
                                    <Run Text="要让别的软件用，就把上面那两个值填进它的设置里（见下表）。" />
                                </TextBlock>

                                <TextBlock Text="常见软件的填法（Base URL 都填 http://127.0.0.1:8787/v1）"
                                           Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" FontFamily="Consolas, Microsoft YaHei UI">
                                    <Run Text="VS Code（Continue / Cline / Roo）" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="  设置里 Provider 选 &quot;OpenAI Compatible&quot;，Base URL 和 API Key 照抄，模型名去「模型」标签页抄。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="Aider（命令行）" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="  set OPENAI_API_BASE=http://127.0.0.1:8787/v1" />
                                    <LineBreak />
                                    <Run Text="  set OPENAI_API_KEY=你的 API Key" />
                                    <LineBreak />
                                    <Run Text="  aider --model openai/glm-5.3" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="自己的 Python / Node 脚本" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="  base_url 和 api_key 照抄，model 填「模型」标签页里的 id。" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,14,0,0" Foreground="#9A6700">
                                    <Run Text="注意：" FontWeight="SemiBold" />
                                    <Run Text="本网关只绑定本机 127.0.0.1，别的电脑连不上（这是好事）。每次对话都会消耗你 WorkBuddy 账号的积分。" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0">
                                    <Run Text="关窗口不会退出：程序会收进系统托盘（右下角），网关继续在后台跑。" />
                                    <LineBreak />
                                    <Run Text="要彻底关掉，右键点托盘图标 → 「退出」；或者去「设置」里取消勾选「关闭窗口时收进托盘」。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasConfigWarning, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="⚠ 配置文件读不了" Style="{StaticResource H1}" Foreground="{StaticResource Warn}" />
                                <TextBlock Text="{Binding ConfigWarning}" Style="{StaticResource Sub}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0">
                                    <Run Text="程序已回退到默认设置，你的原文件完整地备份在旁边。去「设置」重新填一下参数就行。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 环境体检（只在缺东西的时候出现） -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="运行环境" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMain}" Margin="0" />
                                    <Border Background="#FFE9E9" BorderBrush="#F5B5B5" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasEnvironmentProblem, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="缺东西，跑不起来" FontSize="11" Foreground="#8B1A1A" />
                                    </Border>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding EnvironmentChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="13"
                                                           Margin="0,0,8,0" Foreground="{Binding Brush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="{StaticResource TextSub}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding PathsHint}" Style="{StaticResource Sub}"
                                               FontSize="12.5" TextWrapping="Wrap" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="重新体检" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RefreshEnvironmentCommand}" MinWidth="100" />
                                    <Button Content="自动探测" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding DetectPathsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 免责声明 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="免责声明" Style="{StaticResource H1}" />

                                <Border Background="#FFF8E5" BorderBrush="#F0DCA8" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Sub}" Foreground="#7A5B00" FontSize="12.5"
                                               TextWrapping="Wrap">
                                        <Run Text="本程序仅供个人学习与研究使用，只驱动你自己已登录的 WorkBuddy 账号在本机调用。"
                                             FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="请自行确认使用方式符合 WorkBuddy 的服务条款。" />
                                    </TextBlock>
                                </Border>

                                <TextBlock Style="{StaticResource Sub}" FontSize="12">
                                    <Run Text="依赖 WorkBuddy 客户端的非公开接口，上游改动可能导致失效。因使用本程序产生的任何后果" />
                                    <Run Text="（包括但不限于账号被限制、额度被清空、服务中断），由使用者自行承担。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="本程序与腾讯、WorkBuddy、DeepSeek 均无关联，未获其授权或认可；" />
                                    <Run Text="文中出现的名称仅用于描述兼容关系，商标权利归各自所有。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="网关部分（workbuddy_api）的作者是 " />
                                    <Hyperlink NavigateUri="https://github.com/znahovo"
                                               RequestNavigate="OpenLink_Click" Foreground="{StaticResource Accent}">
                                        <Run Text="znahovo" />
                                    </Hyperlink>
                                    <Run Text="，本项目在其之上做了扩展；完整署名与许可分层见仓库的 README 与 LICENSE。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ 一键接入 ══════════════ -->
            <TabItem Header="  一键接入  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <StackPanel Margin="4,10,4,10">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="一个网关，四个客户端" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,14">
                                    <Run Text="本程序直接改各个客户端自己的配置文件，不依赖 CC Switch。" />
                                    <LineBreak />
                                    <Run Text="动手前会把原文件备份到 %APPDATA%\WorkBuddyPanel\backups\，随时能一键还原。" />
                                    <LineBreak />
                                    <Run Text="网关没启动的话，点「全部配置」会先帮你把它拉起来。" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="全部配置" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ConfigureAllCommand}" MinWidth="110"
                                            ToolTip="写 Claude Code / Codex / pi 的配置文件，并把同一份内容镜像进 CC Switch。写前都会备份。" />
                                    <Button Content="还原所有备份" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RestoreAllCommand}" />
                                    <Button Content="重新检测" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RefreshClientsCommand}" />
                                    <Button Content="打开 CC Switch" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding OpenCcSwitchCommand}" />
                                </StackPanel>

                                <TextBlock Text="接入使用的模型" Style="{StaticResource Field}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="320" ItemsSource="{Binding Models}"
                                              SelectedItem="{Binding IntegrateModel, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding IntegrateModelHint}" Style="{StaticResource Sub}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding ClientsSummary}" Style="{StaticResource Sub}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="客户端" Style="{StaticResource H1}" />

                                <ItemsControl ItemsSource="{Binding Clients}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding BadgeBrush}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Badge}" FontSize="11" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" Foreground="{Binding BadgeBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                        <TextBlock Text="{Binding Detail}" FontSize="13" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource Sub}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Sub}"
                                                                   FontSize="11" Margin="0,3,0,0" Foreground="#9A6700"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="配置" Style="{StaticResource GhostButton}"
                                                                Command="{Binding ConfigureCommand}" MinWidth="70" />
                                                        <Button Content="还原" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                                                Command="{Binding RestoreCommand}" MinWidth="70" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasIntegrateResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="配置结果" Style="{StaticResource H1}" />
                                <Border Background="#F6F8FA" CornerRadius="6" Padding="12,10">
                                    <TextBlock Text="{Binding IntegrateResult}" TextWrapping="Wrap"
                                               FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="CC Switch" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12">
                                    <Run Text="CC Switch 是供应商管理器。它切换供应商时是整体覆盖配置文件的 ——" />
                                    <LineBreak />
                                    <Run Text="如果它的列表里没有 WorkBuddy，你在别处切一下就把本程序写好的配置冲掉了。" />
                                    <LineBreak />
                                    <Run Text="所以「全部配置」会顺手把同一份内容镜像进去。不会新建重复条目 —— 你原来就有的那条会被复用。" />
                                </TextBlock>

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding CcSwitchSummary}" Style="{StaticResource Sub}"
                                               FontSize="12.5" TextWrapping="Wrap" />
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="同步到 CC Switch" Style="{StaticResource GhostButton}"
                                            Command="{Binding SyncCcSwitchCommand}" MinWidth="130"
                                            ToolTip="把当前客户端配置镜像进 CC Switch。不动“当前使用”标记。" />
                                    <Button Content="从 CC Switch 写回" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding ApplyFromCcSwitchCommand}" MinWidth="130"
                                            ToolTip="反过来：把 CC Switch 里那份写回客户端配置文件。改前的文件会留备份。" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0">
                                    <Run Text="“当前使用哪个供应商”本程序不碰 —— 那是你的选择，在 CC Switch 里选就行。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="配完怎么用" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}" FontFamily="Consolas, Microsoft YaHei UI">
                                    <Run Text="Claude Code" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="  直接跑 claude 就行，配置写在 ~/.claude/settings.json 的 env 里。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="Codex" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="  ~/.codex/config.toml 里会多一个 model_providers.workbuddy，" />
                                    <LineBreak />
                                    <Run Text="  并把它设为当前 model_provider。切回官方/中转站改这一行即可。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="pi" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="  ~/.pi/agent/models.json 里会多一个叫 WorkBuddy 的供应商，原有的不动。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="DeepSeek Harness" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="  不走本网关。装插件：dsh plugin --profile web add dsh-workbuddy-connect" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ 账号 ══════════════ -->
            <TabItem Header="  账号  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <StackPanel Margin="4,10,4,10">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="多个 WorkBuddy 账号" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12">
                                    <Run Text="桌面 App 一次只能登一个号。点「导入当前账号」把现在登着的那个号存下来，" />
                                    <LineBreak />
                                    <Run Text="再去 App 里换号、回来再导入一次，就能攒出多个。网关用的是「网关正在用」那个号。" />
                                    <LineBreak />
                                    <Run Text="账号信息存在 ~/.workbuddy-api/accounts.cn.json（仅本机，权限 0600），不动 App 自己的登录。" />
                                </TextBlock>

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="网关当前使用：" Style="{StaticResource Sub}" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveAccountText}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导入当前账号" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ImportAccountCommand}" MinWidth="120" />
                                    <Button Content="全部账号：续期 + 签到" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding CheckinAllCommand}" MinWidth="164"
                                            ToolTip="对列表里全部账号发一次刷新请求（会把续期窗口推后），并且签到。已经签过的不会重复签。" />
                                    <Button Content="全部账号：只续期" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RenewAllCommand}" MinWidth="112"
                                            ToolTip="对列表里全部账号发一次刷新请求，把登录有效期推后。不做签到。" />
                                    <Button Content="刷新积分" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RefreshAccountsCommand}"
                                            ToolTip="重新读取每个账号的积分和签到状态（不发刷新请求，不消耗额度）" />
                                    <Button Content="取消选定" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding ClearActiveAccountCommand}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox Content="自动刷新积分" IsChecked="{Binding AccountsAutoRefresh, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AccountsRefreshText}" Style="{StaticResource Sub}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding AccountsSummary}" Style="{StaticResource Sub}" />
                                    <TextBlock Text="　·　上次刷新：" Style="{StaticResource Sub}" />
                                    <TextBlock Text="{Binding AccountsFetchedAt}" Style="{StaticResource Sub}" />
                                    <TextBlock Text="　·　「续期」= 重新拿一个满 60 天的登录有效期，不是重新扫登录。"
                                               Style="{StaticResource Sub}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="搬到另一台电脑" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12">
                                    <Run Text="把账号导出成一个加密文件，在另一台电脑导入就能接着用，不用重新扫码。" />
                                    <LineBreak />
                                    <Run Text="token 是服务端的，跟机器无关；导入时会真的刷一次来验证能不能用。" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导出账号" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ExportAccountsCommand}" MinWidth="110" />
                                    <Button Content="导入账号" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding ImportAccountsCommand}" MinWidth="110" />
                                </StackPanel>

                                <Border Background="#FFF8E5" BorderBrush="#F0DCA8" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Sub}" Foreground="#7A5B00" FontSize="12">
                                        <Run Text="导出文件里有 refreshToken，等同于账号密码：" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="· 口令忘了就解不开，只能重新扫码" />
                                        <LineBreak />
                                        <Run Text="· 文件 + 口令给了别人，等于把这些号的额度给了别人" />
                                        <LineBreak />
                                        <Run Text="· 导入完就把文件删掉，别留在微信 / 网盘里" />
                                    </TextBlock>
                                </Border>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0">
                                    <Run Text="换机器后别忘了在「一键接入」页再点一次「全部配置」—— 客户端配置是指向本机网关的，那边 10 秒就能重配。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="登录不会过期（自动续期）" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12">
                                    <Run Text="WorkBuddy 的登录是滑动窗口：accessToken 活 55 天，refreshToken 活 60 天，" />
                                    <LineBreak />
                                    <Run Text="但服务端每次刷新都会重新发一个满额 60 天的 refreshToken。" />
                                    <LineBreak />
                                    <Run Text="所以在 60 天窗口内刷一次，就又能续 60 天 —— 只要不断，就永远不用再扫码。" />
                                </TextBlock>

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding TaskStatus}" Style="{StaticResource Sub}" FontSize="13" />
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="注册每日自动续期" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RegisterTaskCommand}" MinWidth="140" />
                                    <Button Content="立即跑一次" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RunTaskNowCommand}" />
                                    <Button Content="删除任务" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                            Command="{Binding RemoveTaskCommand}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0">
                                    <Run Text="注册后会在 Windows 计划任务里加一条每天 12:00 的任务，内容是 " />
                                    <Run Text="WorkBuddyPanel.exe --maintain" FontFamily="Consolas" />
                                    <Run Text="：不弹窗，跑完续期+签到就退出。" />
                                    <LineBreak />
                                    <Run Text="电脑到点没开机也没事 —— 任务配了「错过就下次开机补跑」。" />
                                    <LineBreak />
                                    <Run Text="就算不注册这个任务，程序每次启动时也会自己检查：窗口不够就静默续一遍。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="账号列表" Style="{StaticResource H1}" Margin="0" />
                                    <Button Content="↻" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                            Command="{Binding RefreshAccountsCommand}"
                                            ToolTip="刷新全部账号的积分和签到状态" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Accounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <!-- 单行刷新：刷的时候字形变一下，否则 0.5 秒里界面上什么都没发生，
                                                                 用户会以为没点上 -->
                                                            <Button Margin="8,0,0,0"
                                                                    Command="{Binding RefreshCommand}"
                                                                    ToolTip="只刷这一个账号的积分（不查签到，很快）">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                        <Setter Property="Content" Value="↻" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                                                <Setter Property="Content" Value="⋯" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Border Background="#E7F0FE" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="网关正在用" FontSize="11" Foreground="{StaticResource Accent}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding UidShort}" Style="{StaticResource Sub}"
                                                                       FontFamily="Consolas" Margin="10,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="18,8,0,0">
                                                            <TextBlock Text="剩余积分" Style="{StaticResource Sub}" />
                                                            <TextBlock Text="{Binding CreditsText}" FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Accent}" Margin="6,0,16,0" />
                                                            <TextBlock Text="{Binding ExpiresText}" Style="{StaticResource Sub}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding CheckinText}" FontSize="13" Margin="18,8,0,0"
                                                                   Foreground="{Binding CheckinBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding RenewText}" FontSize="13" Margin="18,4,0,0"
                                                                   Foreground="{Binding RenewBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding WeekText}" Style="{StaticResource Sub}"
                                                                   FontSize="13" Margin="18,4,0,0" FontFamily="Consolas, Microsoft YaHei UI" />
                                                        <TextBlock Text="{Binding ActivityText}" Style="{StaticResource Sub}"
                                                                   Margin="18,4,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ErrorText}" FontSize="12" Margin="18,6,0,0"
                                                                   Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <Button Content="设为使用中" Style="{StaticResource PrimaryButton}" MinWidth="96"
                                                                Command="{Binding UseCommand}" />
                                                        <Button Content="续期 + 签到" Style="{StaticResource GhostButton}" MinWidth="96" Margin="0,6,0,0"
                                                                Command="{Binding CheckinCommand}"
                                                                ToolTip="只处理这一个账号：发刷新请求把有效期推后，并签到。" />
                                                        <Button Content="只续期" Style="{StaticResource GhostButton}" MinWidth="96" Margin="0,6,0,0"
                                                                Command="{Binding RenewCommand}"
                                                                ToolTip="只处理这一个账号：发刷新请求把登录有效期推后，不签到。" />
                                                        <Button Content="重命名" Style="{StaticResource GhostButton}" MinWidth="96" Margin="0,6,0,0"
                                                                Command="{Binding RenameCommand}" />
                                                        <Button Content="删除" Style="{StaticResource DangerButton}" MinWidth="96" Margin="0,6,0,0"
                                                                Command="{Binding RemoveCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,14,0,0"
                                           Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVis}}">
                                    <Run Text="还没有账号。先确保 WorkBuddy 桌面 App 登录着，再点上面的「导入当前账号」。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasAccountsResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="操作结果" Style="{StaticResource H1}" />
                                <Border Background="#F6F8FA" CornerRadius="6" Padding="12,10">
                                    <TextBlock Text="{Binding AccountsResult}" TextWrapping="Wrap"
                                               FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="签到是怎么做的" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Sub}">
                                    <Run Text="用的是客户端自己的接口：POST /v2/billing/meter/checkin-activity-status （查）" />
                                    <LineBreak />
                                    <Run Text="和 POST /v2/billing/meter/daily-checkin（签）。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="点「全部签到」会对每个账号先查后签：已经签过的不会重复请求，" />
                                    <LineBreak />
                                    <Run Text="已经过期的令牌会先自动刷新再签。签到得到的积分直接进对应账号。" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="想每天自动签：在「设置」里勾上开机自启，然后在这里就能手动一键签；" />
                                    <LineBreak />
                                    <Run Text="或者命令行跑 workbuddy-api checkin。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ 对话 ══════════════ -->
            <TabItem Header="  对话  ">
                <Grid Margin="4,10,4,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="模型" VerticalAlignment="Center" Style="{StaticResource Sub}" />
                            <ComboBox Width="380" Margin="8,0,0,0"
                                      ItemsSource="{Binding Models}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="刷新列表" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding RefreshModelsCommand}" />
                            <CheckBox Content="记录思考过程" Margin="16,0,0,0"
                                      IsChecked="{Binding ShowReasoning, Mode=TwoWay}" />
                            <Button Content="清空对话" Style="{StaticResource GhostButton}" Margin="16,0,0,0"
                                    Command="{Binding ClearChatCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- 消息区 -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <Grid>
                            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Border x:Name="Bubble" MaxWidth="760" CornerRadius="8" Padding="12,9"
                                                        HorizontalAlignment="Left"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding RoleLabel}" FontSize="11"
                                                                       FontWeight="SemiBold" Foreground="{StaticResource TextSub}" />
                                                            <TextBlock Text="{Binding TimeLabel}" FontSize="11"
                                                                       Foreground="#A0A6AD" Margin="8,0,0,0" />
                                                            <TextBlock Text="● 正在生成…" FontSize="11"
                                                                       Foreground="{StaticResource Accent}" Margin="8,0,0,0"
                                                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>

                                                        <Expander Header="思考过程" Margin="0,0,0,6" IsExpanded="False"
                                                                  Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVis}}">
                                                            <TextBox Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True"
                                                                     TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                                     Padding="0"
                                                                     Foreground="{StaticResource TextSub}" FontSize="12"
                                                                     VerticalScrollBarVisibility="Disabled" IsTabStop="False"
                                                                     MaxHeight="320" />
                                                        </Expander>

                                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                                                                 TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                                 Padding="0"
                                                                 FontSize="14" Foreground="{StaticResource TextMain}"
                                                                 VerticalScrollBarVisibility="Disabled" IsTabStop="False" />

                                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}"
                                                                   FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Bubble" Property="Background" Value="#DDEAFE" />
                                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#C4D9F8" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisInv}}">
                                <Run Text="还没有对话。" />
                                <LineBreak />
                                <Run Text="先在顶上选一个模型（hy3 现在是限时免费），然后在下面输入框里打字回车。" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- 输入区 -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InputBox" Grid.Column="0"
                                     KeyDown="InputBox_KeyDown"
                                     Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" MaxHeight="160"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="13" />

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                <Button Content="发送" Style="{StaticResource PrimaryButton}" MinWidth="86"
                                        Command="{Binding SendCommand}" />
                                <Button Content="停止" Style="{StaticResource GhostButton}" MinWidth="86" Margin="0,6,0,0"
                                        Command="{Binding StopGenerationCommand}" />
                                <TextBlock Text="回车发送 / Shift+回车换行" Style="{StaticResource Sub}"
                                           Margin="0,6,0,0" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════ 模型 ══════════════ -->
            <TabItem Header="  模型  ">
                <Grid Margin="4,10,4,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProviderLabel}" Style="{StaticResource H2}" Margin="0,0,16,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Center">
                                <Run Text="共" />
                                <Run Text="{Binding ModelCountText, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="个　来源：" />
                                <Run Text="{Binding CatalogSourceText, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="16,0,0,0"
                                    Command="{Binding RefreshModelsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <DataGrid ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" RowHeight="32"
                                  BorderThickness="0" Background="Transparent"
                                  HorizontalGridLinesBrush="{StaticResource Line}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="模型 ID" Binding="{Binding Id}" Width="210" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="上下文" Binding="{Binding Context}" Width="90" />
                                <DataGridTextColumn Header="最大输出" Binding="{Binding MaxOutput}" Width="90" />
                                <DataGridTextColumn Header="图片" Binding="{Binding Images}" Width="70" />
                                <DataGridTextColumn Header="积分倍率" Binding="{Binding Rate}" Width="90" />
                                <DataGridTextColumn Header="推理档位" Binding="{Binding Efforts}" Width="120" />
                                <DataGridTextColumn Header="活动" Binding="{Binding Badges}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════ 设置 ══════════════ -->
            <TabItem Header="  设置  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <StackPanel Margin="4,10,4,10">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="运行环境" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMain}" Margin="0" />
                                    <Border Background="#FFF1C9" BorderBrush="#E8CC7A" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding SettingsDirty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="有改动未保存" FontSize="11" Foreground="#7A5B00" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12">
                                    <Run Text="不知道填什么就点「自动探测」。探测不到再手动选。" />
                                    <LineBreak />
                                    <Run Text="{Binding RuntimeDefaultsHint, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Text="node.exe（Node.js 主程序）" Style="{StaticResource Field}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NodePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Grid.ColumnSpan="1" />
                                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="BrowseNode_Click" />
                                </Grid>

                                <TextBlock Text="workbuddy_api 目录" Style="{StaticResource Field}" Margin="0,12,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ApiDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="BrowseApiDir_Click" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="自动探测" Style="{StaticResource PrimaryButton}"
                                            Click="AutoDetect_Click" />
                                    <Button Content="保存设置" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding SaveSettingsCommand}" />                                </StackPanel>

                                <TextBlock Text="{Binding PathsHint}" Style="{StaticResource Sub}" Margin="0,12,0,0" />

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="当前使用" Style="{StaticResource Field}" />
                                        <TextBlock Text="{Binding RuntimeSummary}" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0">
                                    <Run Text="发布包里自带一份 Node.js 和一份 workbuddy_api，放在 exe 旁边的 runtime 子目录。" />
                                    <LineBreak />
                                    <Run Text="发布版默认就填这两个相对路径（.\runtime\node.exe / .\runtime\workbuddy_api），" />
                                    <LineBreak />
                                    <Run Text="所以不需要自己装 Node；把这两个框清空，程序才会去系统里找。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="后台驻留" Style="{StaticResource H1}" />

                                <CheckBox Content="关闭窗口时收进托盘（网关继续在后台运行）"
                                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0,0,0,8" />
                                <CheckBox Content="程序启动时自动拉起网关"
                                          IsChecked="{Binding AutoStartGateway, Mode=TwoWay}" Margin="0,0,0,8" />
                                <CheckBox Content="开机自动启动（静默进托盘，全程不弹窗口）"
                                          IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" Margin="0,0,0,12" />

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="{Binding TrayHint}" Style="{StaticResource Sub}" />
                                </Border>

                                <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0">
                                    <Run Text="勾了开机自启后，系统会在 HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" />
                                    <LineBreak />
                                    <Run Text="里写一条带 --tray 参数的启动项。要真正退出程序（并停掉网关），用托盘右键菜单里的「退出」。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="网关参数" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMain}" Margin="0" />
                                    <Border Background="#FFF1C9" BorderBrush="#E8CC7A" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding SettingsDirty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="有改动未保存" FontSize="11" Foreground="#7A5B00" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="端口（默认 8787，被占用了就改成 8788 之类）" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxWidth="200"
                                         HorizontalAlignment="Left" MinWidth="200" />

                                <TextBlock Text="版本" Style="{StaticResource Field}" Margin="0,12,0,3" />
                                <ComboBox ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding Provider, Mode=TwoWay}"
                                          MaxWidth="240" HorizontalAlignment="Left" MinWidth="240" />

                                <TextBlock Text="API Key（客户端要填的口令，本机自用，随便设）" Style="{StaticResource Field}" Margin="0,12,0,3" />
                                <TextBox Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxWidth="420"
                                         HorizontalAlignment="Left" MinWidth="420" />

                                <TextBlock Text="登录文件路径（留空 = 自动探测，一般不用填）" Style="{StaticResource Field}" Margin="0,12,0,3" />
                                <TextBox Text="{Binding AuthFile, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MaxWidth="620" HorizontalAlignment="Left" MinWidth="620" />

                                <!-- 保存按钮就在这张卡片里，不再让人往上找 -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveSettingsCommand}" MinWidth="110" />
                                    <Button Content="恢复默认" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding ResetSettingsCommand}"
                                            ToolTip="把端口 / API Key / 路径恢复成默认值，并保存" />
                                </StackPanel>

                                <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding SettingsDirtyHint}" Style="{StaticResource Sub}"
                                               FontSize="12.5" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0">
                                    <Run Text="别的开关（托盘常驻、开机自启、自动刷新）改了就是即时生效，不用点保存。" />
                                    <LineBreak />
                                    <Run Text="设置存在 %APPDATA%\WorkBuddyPanel\settings.json，和 workbuddy_api 自己的配置互不干扰。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ 日志 ══════════════ -->
            <TabItem Header="  日志  ">
                <Grid Margin="4,10,4,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="程序与网关的输出" Style="{StaticResource H2}" Margin="0,0,16,0"
                                       VerticalAlignment="Center" />
                            <Button Content="清空日志" Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearLogCommand}" />
                            <TextBlock Text="出问题了就把这里的内容截图发出来" Style="{StaticResource Sub}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
                        <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" />
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- 一次性回执：左边加一个小圆点，一眼能看出“刚才做了个动作” -->
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{StaticResource Accent}"
                             Visibility="{Binding StatusIsTransient, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Sub}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Sub}" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
