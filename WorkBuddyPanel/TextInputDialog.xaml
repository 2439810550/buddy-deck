<Window x:Class="WorkBuddyPanel.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Height="260" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource TextMain}" Margin="0,0,0,12" />

        <TextBox x:Name="ValueBox" Grid.Row="1" FontSize="14" Padding="8,6" />

        <TextBlock x:Name="HintText" Grid.Row="2" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource TextSub}" Margin="0,10,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="Ok_Click" IsDefault="True" />
            <Button Content="取消" Style="{StaticResource GhostButton}" MinWidth="80" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
