<Window x:Class="WorkBuddyPanel.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkBuddy 控制台 — 需要授权"
        Width="660" Height="600"
        MinWidth="620" MinHeight="560"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI">

    <!--
        布局要点（都是实机截图反馈修出来的）：

        1. 按钮**不写死宽度**。中文 8 个字（"打开程序所在目录"）在 125% DPI
           下需要 130+ 逻辑像素，写 Padding 固定值会把字挤到边缘截断。
           这里统一用 MinWidth + 内边距，让 WPF 自己量文字。

        2. **不用 Expander**。它的默认 header 高度是 24 物理像素，
           中文（12px 字号实际占 16px 行高）装不下，底部被切掉。
           机器信息改成常驻的浅色小卡片，本来也没几行。

        3. 窗口尺寸给得宽裕些，并且**允许调整大小** ——
           不同 DPI、不同字体设置下，同样的像素数看起来不一样。
           写死尺寸 + NoResize 是之前"显示不全"的直接原因。

        4. 机器码那行的字号用 18 而不是 19，且在窄屏下仍能完整显示
           16 位十六进制 —— 算过：Consolas 18px 下 16 字符约 175px。
    -->

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题 -->
            <RowDefinition Height="Auto"/>   <!-- 机器码 -->
            <RowDefinition Height="Auto"/>   <!-- 放哪 -->
            <RowDefinition Height="Auto"/>   <!-- 机器信息 -->
            <RowDefinition Height="*"/>      <!-- 弹性留白 -->
            <RowDefinition Height="Auto"/>   <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- ══ 标题 ══ -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="需要授权"
                       FontSize="21" FontWeight="SemiBold" Foreground="#1F2328"/>
            <TextBlock x:Name="SubtitleText" Margin="0,8,0,0"
                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" LineHeight="20"/>
        </StackPanel>

        <!-- ══ 机器码 ══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                CornerRadius="10" Padding="18,16" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="把这串机器码发给作者"
                           FontSize="12.5" Foreground="#6B7280"/>

                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F6F7F9" BorderBrush="#E4E7EC"
                            BorderThickness="1" CornerRadius="8" Padding="14,13" MinHeight="48">
                        <!--
                            TextBox 而不是 TextBlock：

                            TextBlock 在 WPF 里 **不能选中**（不是可编辑控件）。
                            用户想手动复制的时候选不中文字，只能靠旁边的按钮 ——
                            而按钮万一因为剪贴板被占而失败，就彻底没辄了。

                            换成只读 TextBox：能选中、能 Ctrl+C、能右键复制，
                            而且外观通过模板做得跟原来一样（无边框、透明背景）。
                        -->
                        <TextBox x:Name="MachineCodeText"
                                 FontSize="18" FontWeight="SemiBold"
                                 FontFamily="Consolas" Foreground="#2563EB"
                                 Text="________________"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Cursor="IBeam"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 Padding="0">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Border>

                    <!-- MinWidth 76：两个中文字 + 左右各 18 内边距，够宽不会挤 -->
                    <Button Grid.Column="1" x:Name="CopyButton" Content="复制"
                            Click="Copy_Click" Margin="10,0,0,0"
                            MinWidth="76" MinHeight="48"
                            Background="#2563EB" Foreground="White"
                            BorderThickness="0" FontSize="13" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ 授权文件放哪 ══ -->
        <Border Grid.Row="2" Background="#F0F6FF" BorderBrush="#BFD8FF" BorderThickness="1"
                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock FontSize="12.5" Foreground="#3B5A8A"
                           TextWrapping="Wrap" LineHeight="20"
                           Text="收到授权文件后，直接放到本程序所在目录（文件名不用改）。"/>

                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#6B7280"
                           TextWrapping="Wrap" LineHeight="19">
                    也就是和 <Run Text="WorkBuddyPanel.exe" FontFamily="Consolas"/> 放一起。
                    什么文件名都行，不用改。
                    不知道目录在哪就点下面的按钮，会直接给你打开。
                </TextBlock>

                <!-- MinWidth 170：8 个中文字在 12.5px 下约 100px，留足余量 -->
                <Button x:Name="OpenFolderButton" Content="打开程序所在目录"
                        Click="OpenFolder_Click"
                        Margin="0,13,0,0" MinWidth="170" MinHeight="38"
                        HorizontalAlignment="Left"
                        Background="White" Foreground="#2563EB"
                        BorderBrush="#BFD8FF" BorderThickness="1"
                        FontSize="12.5" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ 机器信息（常驻，不用 Expander）══ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="机器信息" FontSize="12" FontWeight="SemiBold"
                           Foreground="#6B7280" Margin="0,0,0,8"/>
                <TextBlock x:Name="ComponentsText"
                           FontSize="11.5" FontFamily="Consolas"
                           Foreground="#6B7280"
                           TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
        </Border>

        <!-- ══ 底部按钮 ══ -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="RetryButton" Content="我已放好，重新检查"
                    Click="Retry_Click"
                    MinWidth="180" MinHeight="40" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="White"
                    BorderThickness="0" FontSize="13" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="退出" Click="Quit_Click"
                    MinWidth="88" MinHeight="40"
                    Background="White" Foreground="#6B7280"
                    BorderBrush="#E4E7EC" BorderThickness="1"
                    FontSize="13" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
