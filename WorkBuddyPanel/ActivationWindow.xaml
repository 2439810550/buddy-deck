<Window x:Class="WorkBuddyPanel.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkBuddy 控制台 — 需要授权"
        Width="620" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI"
        Icon="pack://application:,,,/WorkBuddyPanel;component/app.ico">
    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="需要授权" FontSize="21" FontWeight="SemiBold" Foreground="#1F2328"/>
            <TextBlock x:Name="SubtitleText" Margin="0,7,0,0" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 机器码 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                CornerRadius="10" Padding="18,15" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="把这串机器码发给作者" FontSize="12.5" Foreground="#6B7280"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F6F7F9" BorderBrush="#E4E7EC" BorderThickness="1"
                            CornerRadius="8" Padding="13,11">
                        <TextBlock x:Name="MachineCodeText" FontSize="19" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="#2563EB" Text="____"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="CopyButton" Content="复制" Click="Copy_Click"
                            Margin="10,0,0,0" Padding="17,0" Background="#2563EB" Foreground="White"
                            BorderThickness="0" FontSize="13" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 授权文件位置 -->
        <Border Grid.Row="2" Background="#F0F6FF" BorderBrush="#BFD8FF" BorderThickness="1"
                CornerRadius="10" Padding="18,14" Margin="0,13,0,0">
            <StackPanel>
                <TextBlock Text="收到授权文件后，放进这个目录：" FontSize="12.5" Foreground="#3B5A8A"/>
                <TextBox x:Name="PathText" Margin="0,8,0,0" FontSize="12" FontFamily="Consolas"
                         Background="Transparent" BorderThickness="0" Foreground="#1F4488"
                         IsReadOnly="True" TextWrapping="Wrap"/>
                <Button x:Name="OpenFolderButton" Content="打开这个文件夹" Click="OpenFolder_Click"
                        Margin="0,11,0,0" Padding="14,7" HorizontalAlignment="Left"
                        Background="White" Foreground="#2563EB" BorderBrush="#BFD8FF"
                        BorderThickness="1" FontSize="12.5" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 机器信息（展开可见） -->
        <Expander Grid.Row="3" Margin="0,13,0,0" FontSize="12" Foreground="#6B7280"
                  Header="机器信息（排查问题时用）">
            <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="8" Padding="13,10">
                <TextBlock x:Name="ComponentsText" FontSize="11.5" FontFamily="Consolas"
                           Foreground="#6B7280" TextWrapping="Wrap"/>
            </Border>
        </Expander>

        <TextBlock Grid.Row="4"/>

        <!-- 底部 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="我已放好，重新检查" Click="Retry_Click"
                    Padding="18,9" Background="White" Foreground="#1F2328" BorderBrush="#E4E7EC"
                    BorderThickness="1" FontSize="13" Cursor="Hand" Margin="0,0,9,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="退出" Click="Quit_Click"
                    Padding="18,9" Background="White" Foreground="#6B7280" BorderBrush="#E4E7EC"
                    BorderThickness="1" FontSize="13" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
