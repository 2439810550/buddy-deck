<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 只为托盘图标（NotifyIcon）打开 WinForms；下面的 Using Remove 把 SDK 自动
         注入的 global using 去掉，否则 System.Windows.Forms 会和 WPF 的同名类型打架 -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WorkBuddyPanel</RootNamespace>
    <AssemblyName>WorkBuddyPanel</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyTitle>WorkBuddy 控制台</AssemblyTitle>
    <Product>WorkBuddy 控制台</Product>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 零第三方依赖：只用 WPF + BCL -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      授权校验。用现成的库，不自己写。

      选它而不是手搓签名的原因：密钥格式、XML 序列化边界、时间篡改、
      签名算法的坑太多，这个库有 240 万下载量，这些边界都被踩平了。
    -->
    <PackageReference Include="Standard.Licensing" Version="1.3.0" />
    <!-- 取机器码要查 WMI（主板 UUID / CPU ID）。 -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tools/ 下面是一个独立的发卡工具（有自己的 csproj）。

      不排掉的话，主项目的通配符会把里面的 Program.cs 也拉进来 ——
      然后报「定义了多个入口点」，而且那个文件需要的 using 主项目里没有。
      （踩过：一堆 CS0103 说 Path/File 不存在，其实是在拿 WPF 的编译环境编控制台代码）
    -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <Page Remove="tools/**" />
    <ApplicationDefinition Remove="tools/**" />

    <!--
      tests/ 也得排除 —— 那是一个独立的控制台项目（跑单元测试用的）。

      不排除的话，主项目会递归吸进去它 obj/ 里生成的那些 .cs，
      于是本项目和测试项目各带一份 AssemblyInfo 特性，编译直接挂：

          error CS0579: AssemblyCompanyAttribute 特性重复

      实测踩过：加完测试项目之后，主项目突然编不过。
    -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Page Remove="tests/**" />
    <ApplicationDefinition Remove="tests/**" />
  </ItemGroup>

</Project>
