<Window
    x:Class="BuddyDeck.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:bd="clr-namespace:BuddyDeck.App.Controls"
    Title="BuddyDeck"
    Width="1220"
    Height="780"
    MinWidth="880"
    MinHeight="560"
    WindowStartupLocation="CenterScreen">

    <!--
        ⚠ **不加 `ExtendsContentIntoTitleBar="True"`**。

        曾用过它（追求 Mica 那一片连通的观感），但代价是：
          · Windows 原生的最小化/最大化/关闭按钮**全部消失**
          · 没有 `ui:TitleBar` 替代 → 用户**没法最小化、没法关窗口**
          · 边缘也无法拖动/缩放

        **这是用户实测点名的第一条硬伤**（原话：「没有 Windows 原生的边框最小化
        最大化关闭」）。一个桌面应用不能关窗口，谈不上"能用"。

        ═══ 还有一条实测发现的硬约束：WindowBackdropType 与原生标题栏互斥 ═══

        去掉 `ExtendsContentIntoTitleBar` 之后**又跑了两次才起来**，第一次报：

            System.InvalidOperationException:
              Cannot apply backdrop effect if ExtendsContentIntoTitleBar is false.

        **WPF-UI 4.3.0 的 Mica/Acrylic 必须有 `ExtendsContentIntoTitleBar=true`**
        （自绘标题栏 + 系统材质是同一套机制）。所以两件事**只能选一个**：

            Mica 背景（好看，但窗口没按钮、关不掉）
            vs
            原生标题栏（能关能拖能缩放）

        **选后者。** 一个工具的第一属性是"能用"。
        背景色退回 design 的 `InkBrush`（`#0E1114`，本就是不透明深色，
        原来 Mica 下面也是靠它兜底）—— 观感损失很小。

        **教训（与另两处静默失败同族）**：这两条都是**编译期完全看不出来**的 ——
        `dotnet build` 两次都是 0 错 0 警告，是**真跑起来**才炸的。
        所以本任务的验收里「probe 截图」不是走过场：
        **它是唯一能发现这类问题的手段。**
    -->

    <Grid Background="{DynamicResource InkBrush}">
        <Grid.ColumnDefinitions>
            <!-- 左侧导航：常驻可见 -->
            <ColumnDefinition Width="Auto" />
            <!-- 内容区 -->
            <ColumnDefinition Width="*" />
            <!-- 右侧任务库：常驻入口，可展开/收起 -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            ══════════════════════════════════════════════════════════
             左侧导航栏
            ══════════════════════════════════════════════════════════

            ## 为什么从顶栏页签搬到这里（这是一次设计决定的修正）

            原设计（见旧注释）写的是：「六个页面是平级的，没有二级结构。
            左侧常驻导航栏是在为一个不存在的层级付租金，而日志页/设置页最缺宽度。」

            **那个推理本身没错** —— 六页确实平级、确实不需要*层级*。
            错的是把它当成了「所以不要左导航」的充分理由。

            **漏掉的那个维度**：左导航在桌面工具里还有第二个作用 ——
            把「我在哪、能去哪」变成**常驻可见**的。

            具体代价在实测中暴露出来：
              · 顶栏页签和「应用名 / 网关状态 / 刷新」抢同一行，窄窗口会被挤
              · 内容区窄了之后，日志页/设置页反而更缺宽度（原论证想省的正是宽度）
              · 用户原话：「侧边栏没内容 无交互」

            ⇒ 结论不是"原来错了"，而是"补上一个维度"：
                平级     → 不需要【层级】   （原判对）
                桌面工具 → 需要【常驻导航】 （漏了）
                两者不矛盾，左导航同时满足。
        -->
        <Border
            Grid.Column="0"
            Width="200"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 应用名 -->
                <StackPanel Grid.Row="0" Margin="20,22,20,18">
                    <TextBlock
                        Style="{StaticResource TextSectionTitle}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="BuddyDeck" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource TextSmall}"
                        Foreground="{DynamicResource TextTertiaryBrush}"
                        Text="账号池 · 本地网关" />
                </StackPanel>

                <!-- 导航项：每页一条，图标 + 文字 + 选中态 -->
                <ItemsControl
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    ItemsSource="{Binding Navigation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button
                                Margin="0,2,0,2"
                                Padding="12,0,12,0"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Appearance="Transparent"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnNavItemClick"
                                Cursor="Hand"
                                Tag="{Binding}"
                                ToolTip="{Binding Description}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <!-- 未选中：透明底 + 次级文字色 -->
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <!--
                                                    选中：微亮底 + 主文字色（不再靠下划线，那是顶栏页签的语言）。

                                                    ⚠ 这里原来写的是 `AccentSoftBrush` / 下面那个
                                                    `SurfaceRaisedBrush` / `RadiusControl` —— **三个 key
                                                    在 design 的字典里都不存在**。
                                                    `DynamicResource` 缺失是静默的（只在这条触发器命中时
                                                    表现为"没上色"），但 `StaticResource` 缺失**直接抛
                                                    XamlParseException**：编译 0 错、运行时窗口根本起不来。

                                                    已换成实际存在的：
                                                      AccentSoftBrush → RailBrush         （L2 抬升面，本就是"微亮底"）
                                                      RadiusControl   → RadiusRow         （4px，控件级圆角）
                                                -->
                                                <Setter Property="Background" Value="{DynamicResource RailBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- WPF 的 StackPanel 没有 Spacing（HANDOVER 坑 5）—— 用 Margin -->
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Symbol="{Binding Icon}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Title}" />
                                </StackPanel>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    底部：网关状态 + 状态轨。
                    状态轨（bd:StatusRail）原来独占左侧 56px 一整列，但它只画出
                    左下角两个数字、中间大片空白 —— 用户看到的是"侧边栏坏了"。
                    它的信息（几个号可用/总共几个）本来就只有两行，放这里更合适。
                -->
                <StackPanel Grid.Row="2" Margin="14,0,14,16">
                    <Border
                        Margin="0,0,0,10"
                        Padding="10,8"
                        Background="{DynamicResource RailSubtleBrush}"
                        CornerRadius="{StaticResource RadiusRow}">
                        <StackPanel>
                            <!-- ★ 网关状态：已启动 / 未启动 + 图标开关按钮 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <bd:StatusDot
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Online="{Binding GatewayOnline}"
                                        Stale="{Binding GatewayStale}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource TextSmall}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding StatusLine}" />
                                </StackPanel>
                                <!-- 未启动：醒目的紧凑启动按钮 -->
                                <ui:Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    Appearance="Primary"
                                    Command="{Binding ToggleGatewayCommand}"
                                    Content="启动"
                                    FontSize="11"
                                    Icon="{ui:SymbolIcon Symbol=Play24}"
                                    ToolTip="启动网关"
                                    Visibility="{Binding GatewayRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                                <!-- 已启动：醒目的紧凑停止按钮 -->
                                <ui:Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    Appearance="Danger"
                                    Command="{Binding ToggleGatewayCommand}"
                                    Content="停止"
                                    FontSize="11"
                                    Icon="{ui:SymbolIcon Symbol=Stop24}"
                                    ToolTip="停止网关"
                                    Visibility="{Binding GatewayRunning, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <!-- 在线：端口 + 产物名（一句小字）-->
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource TextMicro}"
                                Foreground="{DynamicResource TextTertiaryBrush}"
                                Text="{Binding GatewayDetail}"
                                TextWrapping="Wrap"
                                Visibility="{Binding GatewayOnline, Converter={StaticResource BoolToVisibility}}" />

                            <!-- 未启动：为什么（一句小字原因）-->
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource TextMicro}"
                                Foreground="{DynamicResource WarnBrush}"
                                Text="{Binding OfflineReason}"
                                TextWrapping="Wrap"
                                Visibility="{Binding OfflineReason, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource TextSmall}"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            Text="可用账号" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource TextSmall}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding RailUsable}" />
                            <TextBlock
                                Style="{StaticResource TextSmall}"
                                Foreground="{DynamicResource TextTertiaryBrush}"
                                Text=" / " />
                            <TextBlock
                                Style="{StaticResource TextSmall}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding RailTotal}" />
                        </StackPanel>
                    </Grid>

                    <!-- ★ 模型数量：网关在线时实时上报，离线不显示 -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding HasModelCount, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource TextSmall}"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            Text="可用模型" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource TextSmall}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding ModelCount}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            内容区。
            用 ContentControl 而不是 Frame：Frame 只吃 System.Windows.Controls.Page，
            而我们的页面是 UserControl。ContentControl 直接换 Content，更直接，
            也不需要导航日志（这个界面没有前进/后退的概念）。
        -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 内容区顶栏：只留刷新（导航已搬到左侧） -->
            <Border
                Grid.Row="0"
                Height="48"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <!-- ★ 任务库入口：常驻可见，点了展开/收起底部任务面板 -->
                    <ui:Button
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Click="OnToggleTasks"
                        Content="任务库"
                        Icon="{ui:SymbolIcon Symbol=ChartMultiple24}" />
                    <ui:Button
                        Margin="0,0,20,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Click="OnRefreshClick"
                        Content="刷新"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                </StackPanel>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1" />

            <!--
                ★ 任务库遮罩：任务库展开时盖在内容区上。
                任务运行中它也**显示**，但点击不收起（OnDismissTasksOverlay 里判断）；
                任务空闲时才响应点击收起 —— 这样遮罩不会在任务完成瞬间「突然出现」
                误触用户正在进行的操作。
            -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="Transparent"
                Cursor="Arrow"
                MouseLeftButtonDown="OnDismissTasksOverlay"
                Visibility="{Binding TasksVisible, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!--
            右侧任务库（用户需求）：常驻入口，可展开/收起，
            显示后台任务（拉积分/签到/续期）的进度条 + 实时描述。
            有任务在跑时自动展开。

            为什么在右侧而不是底部：底部横条会把内容区上下挤压，
            而右侧栏与左侧导航对称，内容区宽度不受影响，
            且任务列表可以纵向排更多行。
        -->
        <Border
            Grid.Column="2"
            Margin="0,0,0,0"
            Padding="14,12,14,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1,0,0,0"
            RenderTransformOrigin="1,0.5"
            Visibility="{Binding TasksVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.RenderTransform>
                <TranslateTransform X="320" />
            </Border.RenderTransform>
            <!-- ★ 任务库滑入：从右侧滑进来（Loaded 触发，因为 Visibility 从
                 Collapsed 变 Visible 会重新进视觉树）。关闭是瞬时的（遮罩点击后
                 Collapsed），符合「点外收起」的直觉。 -->
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="{StaticResource MotionExpand}" />
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                From="320" To="0" Duration="{StaticResource MotionExpand}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid Width="320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- 标题行：任务库 + 运行数（收起按钮就是入口那个，这里不再重复放）-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextSectionTitle}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="任务库" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextSmall}"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="{Binding TasksSummary}"
                            Visibility="{Binding TasksSummary, Converter={StaticResource StringToVisibility}}" />
                    </Grid>
                </StackPanel>

                <!-- 任务列表（点一行内联展开它的详情事件流）-->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TaskList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="10,8,10,8"
                                        Background="{DynamicResource RailSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusRow}">
                                        <StackPanel>
                                            <Grid
                                                Background="Transparent"
                                                Cursor="Hand"
                                                ToolTip="点击查看执行流程"
                                                MouseLeftButtonUp="OnTaskRowClick">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        Style="{StaticResource TextBody}"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Style="{StaticResource TextSmall}"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="8,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource TextSmall}"
                                                        Foreground="{DynamicResource TextTertiaryBrush}"
                                                        Text="{Binding StatusText}" />
                                                    <!-- ★ 详情提示箭头：点这行看执行流程 -->
                                                    <ui:SymbolIcon
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextTertiaryBrush}"
                                                        Symbol="ChevronDown24" />
                                                </StackPanel>
                                            </Grid>
                                            <!-- 进度条：原生 ProgressBar（0-100 直接绑 Progress） -->
                                            <ProgressBar
                                                Height="4"
                                                Margin="0,6,0,0"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Progress}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Background="{DynamicResource RailBrush}"
                                                BorderThickness="0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- ★ 详情内联：展开在**这一行**下面（不是列表末尾）-->
                                    <Border
                                        Margin="6,0,6,10"
                                        Padding="10,8,10,8"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="{StaticResource BorderHairline}"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        RenderTransformOrigin="0.5,0"
                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0.6" />
                                        </Border.RenderTransform>
                                        <!-- 详情展开动画：从压扁 + 透明，弹到展开 -->
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="0" To="1" Duration="{StaticResource MotionExpand}" />
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                            From="0.6" To="1" Duration="{StaticResource MotionExpand}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource TextSectionTitle}"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource TextMicro}"
                                                    Foreground="{DynamicResource TextTertiaryBrush}"
                                                    Text="执行流程" />
                                            </Grid>
                                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Events}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Style="{StaticResource TextMicro}"
                                                                Foreground="{DynamicResource TextTertiaryBrush}"
                                                                Text="{Binding Time}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="6,0,6,0"
                                                                Text="{Binding Message}"
                                                                TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style BasedOn="{StaticResource TextSmall}" TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource StopBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Style="{StaticResource TextMicro}"
                                                                Foreground="{DynamicResource TextTertiaryBrush}"
                                                                Text="{Binding ProgressText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
