<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    BuddyDeck Hub —— 把本机多个 workbuddy_api 实例聚合成一个多租户中转站。

    设计参考 one-api / new-api 那一套：
        成员(User) → 令牌(Token) → 分组(Group) → 渠道(Channel=一个网关实例)

    这里「渠道」= 一个独立的 workbuddy_api 进程，靠 WORKBUDDY_API_HOME 隔离账号池。
    好处：workbuddy_api 一行不用改，它那套 loopback + Host 校验的边界保持原样。

    依赖只有 Microsoft.Data.Sqlite（微软官方包，写日志和配额）。
    密码哈希用 BCL 自带的 PBKDF2，不引第三方。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BuddyDeckHub</RootNamespace>
    <AssemblyName>BuddyDeckHub</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
