node_modules/
*.log
.DS_Store
.env

# 临时探针脚本和数据（排查时现造，不该入库）
_probe*.mjs
_probe*.js
_probe*.json
_ai-config.json
_ai*.mjs
_verify-*.mjs
_e2e-*.mjs
_probe-*.txt

# local runtime state (never commit: contains credential copies)
.workbuddy-api/
*.workbuddy-auth.json

# skill-local credentials: the skill talks to the local gateway and must never
# carry a token, but guard the path anyway so an old direct-connect token.json
# (or a stray one copied in while debugging) can't be committed by accident.
skills/**/token.json
skills/**/*.workbuddy-auth.json
# 临时抓包 / 调试脚本（排查上游时现造）
_*.mjs
_*.json
*.bak-*
*.bak
